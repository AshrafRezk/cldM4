{
  "x-cloudiator-scope": [
    "voice"
  ],
  "paths": {
    "/v1/voice/scripts": {
      "post": {
        "operationId": "voiceScriptsPublish",
        "summary": "Publish a phone script. Send Definition__c as the definition string.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceScriptPublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceScriptPublished"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "voiceScriptsList",
        "summary": "List this tenant's published scripts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceScriptList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/sessions": {
      "get": {
        "operationId": "voiceSessionsList",
        "summary": "List call sessions, newest first. Filter with status=ready_to_commit.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSessionList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/sessions/{id}": {
      "get": {
        "operationId": "voiceSessionsGet",
        "summary": "One call session. commit_json is the CRM commit document.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSession"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/sessions/{id}/ack": {
      "post": {
        "operationId": "voiceSessionsAck",
        "summary": "Record the Salesforce Ids inserted from commit_json",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceAckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSession"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/scripts/{id}/web-link": {
      "post": {
        "operationId": "voiceWebLinkCreate",
        "summary": "Mint a browser call link for a published script. Shown once; anyone with it can start a call.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceWebLink"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/scripts/{id}/web-link/revoke": {
      "post": {
        "operationId": "voiceWebLinkRevoke",
        "summary": "Revoke every call link of a script. Calls already in progress finish.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceWebLinkRevoked"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VoiceScriptPublishRequest": {
        "type": "object",
        "required": [
          "definition"
        ],
        "properties": {
          "definition": {
            "type": "string",
            "description": "The script JSON (Definition__c), as a string"
          }
        }
      },
      "VoiceScriptPublished": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "VoiceScriptSummary": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "inbound_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "VoiceScriptList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceScriptSummary"
            }
          }
        }
      },
      "VoiceSession": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "call_sid": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "script_id": {
            "type": "string"
          },
          "script_version": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "description": "in_progress, ready_to_commit, committed, or abandoned"
          },
          "current_step": {
            "type": "string"
          },
          "transcript": {
            "type": "string"
          },
          "recording_url": {
            "type": "string"
          },
          "commit_json": {
            "type": "string",
            "description": "CRM commit document: {records:[{sobject, fields, after}]}. Deserialize untyped in Apex."
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "VoiceSessionList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceSession"
            }
          }
        }
      },
      "VoiceAckRecord": {
        "type": "object",
        "required": [
          "sobject",
          "id"
        ],
        "properties": {
          "sobject": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "VoiceAckRequest": {
        "type": "object",
        "required": [
          "records"
        ],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceAckRecord"
            }
          }
        }
      },
      "VoiceWebLink": {
        "type": "object",
        "required": [
          "script_id",
          "url"
        ],
        "properties": {
          "script_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "VoiceWebLinkRevoked": {
        "type": "object",
        "required": [
          "revoked"
        ],
        "properties": {
          "revoked": {
            "type": "integer"
          }
        }
      }
    }
  }
}
