# Copy to apps/dashboard/.env for `netlify dev` only. Never commit real values.
# Production values belong in the Netlify site env UI (server functions only).

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PUBLIC_API_URL=https://api.cloudiator.org
ADMIN_SESSION_SECRET=replace-with-32-plus-random-bytes
# Local netlify dev only. Production trusts Cf-Access-Authenticated-User-Email.
DEV_ACCESS_EMAIL=you@example.com
