<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.cloudiator.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DATA__/run-worker.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/apps/worker</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MPLBACKEND</key><string>Agg</string>
    <key>WEB_CONCURRENCY</key><string>1</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>2</string>
    <key>CLOUDIATOR_ENV</key><string>production</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DATA__/logs/worker.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/worker.err</string>
</dict>
</plist>
