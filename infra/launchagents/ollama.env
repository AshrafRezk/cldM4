# Copy onto the Ollama.app environment (or a dedicated Ollama LaunchAgent).
# Slot 1 = one generative model. Slot 2 = nomic-embed-text only.
# The worker always sends explicit keep_alive; 30m is a crash safety net only.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_ORIGINS=http://127.0.0.1:8080
