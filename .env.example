# Copy to ~/Cloudiator/.env on the Mac Mini, then: chmod 600 ~/Cloudiator/.env
# Never commit the real file. Keep it OUTSIDE the git working tree.

CLOUDIATOR_ENV=production
HOST=127.0.0.1
PORT=8080
WEB_CONCURRENCY=1
PUBLIC_BASE_URL=https://api.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- models -----------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Slot 1 = one generative model, slot 2 = nomic-embed-text only. The worker
# asserts this is exactly 2 and refuses to boot otherwise (PLAN.md section 4).
# It must also be set on the Ollama server itself; scripts/mac-setup.sh does
# that with launchctl setenv.
OLLAMA_MAX_LOADED_MODELS=2
# Set DEFAULT_MODEL to the tag you actually verified in Phase A step 0.
# Pin the QAT Q4_0 GGUF tag. Do NOT use gemma4 / gemma4:latest (Q4_K_M ~9.6GB).
# Do NOT use gemma4:*-mlx (prefix cache on Gemma 4 hybrid KV is unreliable).
DEFAULT_MODEL=gemma4:e4b-it-qat
EMBED_MODEL=nomic-embed-text
INFERENCE_BACKEND=ollama
# Optional Arabic/vision quality upgrade — replaces E4B, never coresident.
# DEFAULT_MODEL=gemma4:12b-it-qat
# Gemma 4 E4B/12B QAT is a VLM. Set false only if the tag gate fell back to a
# text-only model (PLAN.md section 7).
DEFAULT_MODEL_HAS_VISION=true
# HEAVY_MODEL stays commented out until the Phase E pull completes (~14GB).
# An advertised-but-absent model triggers a 14GB download inside an HTTP request.
# HEAVY_MODEL=gpt-oss:20b
# DEFAULT_MODEL is the VLM (Gemma 4). Leave VISION_MODEL empty unless the tag
# gate fell back to a text-only model AND you accepted the slot-swap cost.
# VISION_MODEL=
# Thinking burns max_tokens and the 75s tool loop. Off for Salesforce / default.
GEMMA_THINKING=false
NUM_CTX=4096
# Hard ceiling on num_ctx; the worker clamps to this (PLAN.md section 4).
NUM_CTX_MAX=8192
MAX_TOKENS_DEFAULT=512

# --- limits and budgets -----------------------------------------------------
MAX_TOOL_ITERATIONS=8
TOOL_LOOP_BUDGET_SECONDS=75
SYNC_DEADLINE_SECONDS=90
MAX_RESPONSE_BYTES=1048576
VISION_MAX_EDGE_PX=1024
VISION_MAX_IMAGES=4
KEY_CACHE_TTL_SECONDS=60

# --- database pool (Mini is one long-lived process; Neon auto-suspends) ------
DB_POOL_MIN=0
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300

# --- storage ----------------------------------------------------------------
ARTIFACT_DIR=/Users/REPLACE/Cloudiator/artifacts
ARTIFACT_TTL_HOURS=24
ARTIFACT_URL_TTL_SECONDS=900
MIN_FREE_DISK_GB=10
QUEUE_DB=/Users/REPLACE/Cloudiator/queue.db
GEOCODE_CACHE_DB=/Users/REPLACE/Cloudiator/geocode.db
MFLUX_MODEL_PATH=/Users/REPLACE/Cloudiator/models/flux-schnell-4bit
HF_HOME=/Users/REPLACE/.cache/huggingface

# --- secrets ----------------------------------------------------------------
ARTIFACT_SIGNING_SECRET=replace-with-32-plus-random-bytes
# ADMIN_TOKEN is a loopback-only break-glass. Public /v1/admin goes through
# Cloudflare Access JWT validation, not this token.
ADMIN_TOKEN=replace-with-random-admin-token
CF_ACCESS_TEAM_DOMAIN=replace.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-aud
LOG_PROMPTS_DEFAULT=false

# --- maps / external services ----------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
# A real, monitored mailbox. A generic User-Agent gets your home IP blocked.
NOMINATIM_USER_AGENT=Cloudiator/0.1 (you@example.com)
NOMINATIM_MAX_ROWS_PER_REQUEST=25
OVERPASS_URLS=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
# GOOGLE_MAPS_API_KEY=
# SLACK_WEBHOOK_URL=
# HF_TOKEN=

# --- renderers --------------------------------------------------------------
MPLBACKEND=Agg
# mermaid-cli ships a headless Chromium: 0.4-1.2GB resident per render.
# Graphviz is the default diagram renderer. Leave this false unless you need Mermaid.
ENABLE_MERMAID=false
