# Copy to ~/Cloudiator/.env on the Mac Mini. Never commit the real file.

CLOUDIATOR_ENV=production
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3.5:9b
HEAVY_MODEL=gpt-oss:20b
EMBED_MODEL=nomic-embed-text
NUM_CTX=4096
MAX_TOKENS_DEFAULT=512

ARTIFACT_DIR=/Users/REPLACE/Cloudiator/artifacts
QUEUE_DB=/Users/REPLACE/Cloudiator/queue.db
ARTIFACT_SIGNING_SECRET=replace-with-32-plus-random-bytes
ADMIN_TOKEN=replace-with-random-admin-token
LOG_PROMPTS_DEFAULT=false

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Cloudiator/0.1 (you@example.com)
OVERPASS_URLS=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
# GOOGLE_MAPS_API_KEY=
# SLACK_WEBHOOK_URL=
# HF_TOKEN=

MPLBACKEND=Agg
